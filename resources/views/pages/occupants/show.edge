<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>MESS KSO | Detail Penghuni</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    .layout {
      min-height: 100vh;
      display: flex;
    }

    .sidebar {
      width: 260px;
      background: #082d60;
      color: white;
      padding: 28px 18px;
      position: fixed;
      inset: 0 auto 0 0;
      display: flex;
      flex-direction: column;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 12px 28px;
      border-bottom: 1px solid rgba(255,255,255,.12);
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: white;
      color: #082d60;
      display: grid;
      place-items: center;
      font-weight: 800;
    }

    .brand h1 {
      font-size: 19px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      font-size: 11px;
      opacity: .65;
    }

    .menu {
      margin-top: 28px;
    }

    .menu-title {
      padding: 0 12px;
      margin: 22px 0 9px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.2px;
      opacity: .45;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      margin-bottom: 5px;
      border-radius: 10px;
      color: rgba(255,255,255,.78);
      text-decoration: none;
      font-size: 14px;
    }

    .menu a:hover,
    .menu a.active {
      background: rgba(255,255,255,.12);
      color: white;
    }

    .sidebar-bottom {
      margin-top: auto;
    }

    .main {
      margin-left: 260px;
      width: calc(100% - 260px);
      min-height: 100vh;
    }

    .topbar {
      height: 76px;
      background: white;
      border-bottom: 1px solid #e8edf4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 34px;
    }

    .page-title h2 {
      font-size: 20px;
    }

    .page-title p {
      margin-top: 4px;
      color: #8791a5;
      font-size: 13px;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e8f0fb;
      color: #082d60;
      display: grid;
      place-items: center;
      font-weight: 700;
    }

    .profile-name {
      font-size: 13px;
      font-weight: 700;
    }

    .profile-role {
      font-size: 11px;
      color: #16845b;
      margin-top: 3px;
    }

    .content {
      padding: 34px;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 22px;
    }

    .page-header h1 {
      font-size: 25px;
      color: #102f67;
    }

    .page-header p {
      margin-top: 5px;
      color: #8791a5;
      font-size: 13px;
    }

    .actions {
      display: flex;
      gap: 9px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 16px;
      border-radius: 10px;
      text-decoration: none;
      border: 0;
      cursor: pointer;
      font-size: 13px;
      font-weight: 700;
    }

    .btn-primary {
      background: #082d60;
      color: white;
    }

    .btn-primary:hover {
      background: #0b4b96;
    }

    .btn-secondary {
      background: #eef2f7;
      color: #526078;
    }

    .btn-danger {
      background: #fff0f1;
      color: #c6283d;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: 310px 1fr;
      gap: 22px;
      max-width: 1100px;
    }

    .panel {
      background: white;
      border: 1px solid #e8edf4;
      border-radius: 16px;
      padding: 25px;
    }

    .profile-panel {
      text-align: center;
    }

    .profile-photo {
      width: 150px;
      height: 150px;
      margin: 0 auto 18px;
      border-radius: 50%;
      overflow: hidden;
      background: #e8f0fb;
      color: #082d60;
      display: grid;
      place-items: center;
      font-size: 48px;
      font-weight: 800;
    }

    .profile-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-panel h2 {
      color: #102f67;
      font-size: 20px;
    }

    .profile-panel .position {
      margin-top: 6px;
      color: #8791a5;
      font-size: 13px;
    }

    .status {
      display: inline-flex;
      align-items: center;
      margin-top: 15px;
      padding: 6px 11px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .status-active {
      background: #e8f7ef;
      color: #16845b;
    }

    .status-inactive {
      background: #fff0f1;
      color: #c6283d;
    }

    .status-moved {
      background: #fff7df;
      color: #a26b00;
    }

    .section-title {
      color: #102f67;
      font-size: 15px;
      margin-bottom: 20px;
      padding-bottom: 13px;
      border-bottom: 1px solid #edf1f6;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 28px;
    }

    .info-label {
      color: #8791a5;
      font-size: 11px;
      margin-bottom: 5px;
    }

    .info-value {
      color: #26344d;
      font-size: 13px;
      font-weight: 600;
    }

    .info-value.empty {
      color: #b0b8c6;
      font-weight: 400;
    }

    .description {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #edf1f6;
    }

    .description-label {
      color: #8791a5;
      font-size: 11px;
      margin-bottom: 8px;
    }

    .description-value {
      color: #526078;
      font-size: 13px;
      line-height: 1.7;
      white-space: pre-line;
    }

    .house-box {
      margin-top: 24px;
      padding: 17px;
      border-radius: 12px;
      background: #f5f8fc;
      border: 1px solid #e6ecf4;
    }

    .house-box-title {
      color: #8791a5;
      font-size: 11px;
      margin-bottom: 6px;
    }

    .house-name {
      color: #102f67;
      font-size: 14px;
      font-weight: 700;
    }

    .house-room {
      margin-top: 4px;
      color: #526078;
      font-size: 12px;
    }

    .delete-form {
      display: inline;
    }

    @media (max-width: 850px) {
      .sidebar {
        display: none;
      }

      .main {
        margin-left: 0;
        width: 100%;
      }

      .content {
        padding: 20px;
      }

      .detail-grid {
        grid-template-columns: 1fr;
      }

      .page-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<div class="layout">

  <aside class="sidebar">

    <div class="brand">
      <div class="brand-icon">KSO</div>

      <div>
        <h1>MESS KSO</h1>
        <span>Management System</span>
      </div>
    </div>

    <nav class="menu">

      <div class="menu-title">MENU UTAMA</div>

      <a href="/dashboard">
        <span>▦</span>
        <span>Dashboard</span>
      </a>

      <a href="/occupants" class="active">
        <span>♙</span>
        <span>Penghuni</span>
      </a>

      <a href="/houses">
        <span>⌂</span>
        <span>Rumah Mess</span>
      </a>

      <div class="menu-title">KSO</div>

      <a href="#">
        <span>▣</span>
        <span>Request KSO</span>
      </a>

    </nav>

    <div class="sidebar-bottom">

      <form method="POST" action="/logout">
        {{ csrfField() }}

        <button
          type="submit"
          style="width:100%;background:transparent;border:0;color:rgba(255,255,255,.78);padding:12px;text-align:left;cursor:pointer;font-size:14px;"
        >
          ⇥ &nbsp; Keluar
        </button>
      </form>

    </div>

  </aside>

  <main class="main">

    <header class="topbar">

      <div class="page-title">
        <h2>Penghuni</h2>
        <p>Master Data / Penghuni / Detail</p>
      </div>

      <div class="profile">

        <div class="avatar">
          {{ (auth.user?.fullName || 'A').charAt(0).toUpperCase() }}
        </div>

        <div>
          <div class="profile-name">
            {{ auth.user?.fullName || 'Administrator' }}
          </div>

          <div class="profile-role">
            {{ auth.user?.role || 'super_admin' }}
          </div>
        </div>

      </div>

    </header>

    <section class="content">

      <div class="page-header">

        <div>
          <h1>Detail Penghuni</h1>
          <p>Informasi lengkap penghuni MESS KSO.</p>
        </div>

        <div class="actions">

          <a
            href="/occupants"
            class="btn btn-secondary"
          >
            ← Kembali
          </a>

          <a
            href="/occupants/{{ occupant.id }}/edit"
            class="btn btn-primary"
          >
            ✎ Edit
          </a>

          <form
            method="POST"
            action="/occupants/{{ occupant.id }}/delete"
            class="delete-form"
            onsubmit="return confirm('Yakin ingin menghapus penghuni ini?')"
          >
            {{ csrfField() }}

            <button
              type="submit"
              class="btn btn-danger"
            >
              Hapus
            </button>
          </form>

        </div>

      </div>

      <div class="detail-grid">

        <div class="panel profile-panel">

          <div class="profile-photo">

            @if (occupant.photo)

              <img
                src="{{ occupant.photo }}"
                alt="{{ occupant.name }}"
              >

            @else

              {{ occupant.name.charAt(0).toUpperCase() }}

            @endif

          </div>

          <h2>{{ occupant.name }}</h2>

          <div class="position">

            @if (occupant.position)
              {{ occupant.position.name }}
            @else
              Jabatan belum diisi
            @endif

          </div>

          @if (occupant.status === 'active')

            <span class="status status-active">
              Aktif
            </span>

          @elseif (occupant.status === 'inactive')

            <span class="status status-inactive">
              Tidak Aktif
            </span>

          @elseif (occupant.status === 'moved')

            <span class="status status-moved">
              Pindah
            </span>

          @else

            <span class="status status-inactive">
              {{ occupant.status }}
            </span>

          @endif

          @if (occupant.house)

            <div class="house-box">

              <div class="house-box-title">
                RUMAH MESS
              </div>

              <div class="house-name">
                {{ occupant.house.name }}
              </div>

              <div class="house-room">

                Kode: {{ occupant.house.code }}

                @if (occupant.roomNumber)
                  · Kamar {{ occupant.roomNumber }}
                @endif

              </div>

            </div>

          @endif

        </div>

        <div class="panel">

          <h3 class="section-title">
            Informasi Penghuni
          </h3>

          <div class="info-grid">

            <div>
              <div class="info-label">
                Nama Lengkap
              </div>

              <div class="info-value">
                {{ occupant.name }}
              </div>
            </div>

            <div>
              <div class="info-label">
                NIK
              </div>

              @if (occupant.nik)
                <div class="info-value">
                  {{ occupant.nik }}
                </div>
              @else
                <div class="info-value empty">
                  Belum diisi
                </div>
              @endif

            </div>

            <div>
              <div class="info-label">
                Nomor HP
              </div>

              @if (occupant.phone)
                <div class="info-value">
                  {{ occupant.phone }}
                </div>
              @else
                <div class="info-value empty">
                  Belum diisi
                </div>
              @endif

            </div>

            <div>
              <div class="info-label">
                Jabatan
              </div>

              @if (occupant.position)
                <div class="info-value">
                  {{ occupant.position.name }}
                </div>
              @else
                <div class="info-value empty">
                  Belum diisi
                </div>
              @endif

            </div>

            <div>
              <div class="info-label">
                Tempat Kerja
              </div>

              @if (occupant.workplace)
                <div class="info-value">
                  {{ occupant.workplace }}
                </div>
              @else
                <div class="info-value empty">
                  Belum diisi
                </div>
              @endif

            </div>

            <div>
              <div class="info-label">
                Rumah Mess
              </div>

              @if (occupant.house)
                <div class="info-value">
                  {{ occupant.house.name }}
                </div>
              @else
                <div class="info-value empty">
                  Belum ditempatkan
                </div>
              @endif

            </div>

            <div>
              <div class="info-label">
                Nomor Kamar
              </div>

              @if (occupant.roomNumber)
                <div class="info-value">
                  {{ occupant.roomNumber }}
                </div>
              @else
                <div class="info-value empty">
                  Belum diisi
                </div>
              @endif

            </div>

            <div>
              <div class="info-label">
                Status
              </div>

              <div class="info-value">
                {{ occupant.status }}
              </div>
            </div>

          </div>

          <div class="description">

            <div class="description-label">
              KETERANGAN
            </div>

            @if (occupant.description)

              <div class="description-value">
                {{ occupant.description }}
              </div>

            @else

              <div class="info-value empty">
                Tidak ada keterangan.
              </div>

            @endif

          </div>

        </div>

      </div>

    </section>

  </main>

</div>

</body>
</html>
