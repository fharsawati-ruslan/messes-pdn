<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Tambah Rumah Mess | MESS KSO</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    .page {
      min-height: 100vh;
      padding: 35px;
    }

    .header {
      margin-bottom: 25px;
    }

    .header h1 {
      color: #082d60;
      font-size: 26px;
    }

    .header p {
      margin-top: 6px;
      color: #8791a5;
      font-size: 13px;
    }

    .panel {
      max-width: 900px;
      background: white;
      border: 1px solid #e5eaf1;
      border-radius: 16px;
      padding: 28px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    label {
      margin-bottom: 8px;
      color: #40516d;
      font-size: 12px;
      font-weight: 700;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #dce3ed;
      border-radius: 9px;
      background: white;
      color: #172033;
      font-family: inherit;
      font-size: 13px;
      outline: none;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #2563eb;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .hint {
      margin-top: 6px;
      color: #8791a5;
      font-size: 11px;
    }

    .actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid #edf0f5;
    }

    .btn {
      border: 0;
      padding: 11px 18px;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
    }

    .btn-cancel {
      background: #eef1f5;
      color: #526176;
    }

    .btn-save {
      background: #082d60;
      color: white;
    }

    .checkbox {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-top: 8px;
    }

    .checkbox input {
      width: auto;
    }

    .checkbox label {
      margin: 0;
    }

    @media (max-width: 700px) {
      .page {
        padding: 20px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }
    }
  </style>
</head>

<body>

<div class="page">

  <div class="header">
    <div style="display:flex; align-items:center; gap:12px;">
      <a
        href="/dashboard"
        style="
          display:inline-flex;
          align-items:center;
          justify-content:center;
          width:38px;
          height:38px;
          border-radius:9px;
          background:#e8eef7;
          color:#082d60;
          font-size:18px;
          font-weight:700;
          text-decoration:none;
        "
        title="Kembali ke Dashboard"
      >
        ←
      </a>

      <div>
        <h1>Tambah Rumah Mess</h1>
        <p>Tambahkan data rumah mess baru ke sistem MESS KSO.</p>
      </div>
    </div>
  </div>

  <div class="panel">

    <form method="POST" action="/houses">

      <div class="grid">

        <div class="form-group">
          <label for="code">
            Kode Rumah
          </label>

          <input
            id="code"
            type="text"
            name="code"
            maxlength="50"
            required
            placeholder="Contoh: RM-003"
          >

          <div class="hint">
            Gunakan kode unik untuk setiap rumah.
          </div>
        </div>


        <div class="form-group">
          <label for="name">
            Nama Rumah
          </label>

          <input
            id="name"
            type="text"
            name="name"
            maxlength="100"
            required
            placeholder="Contoh: Rumah Melati"
          >
        </div>


        <div class="form-group full">
          <label for="address">
            Alamat
          </label>

          <input
            id="address"
            type="text"
            name="address"
            maxlength="255"
            placeholder="Alamat rumah mess"
          >
        </div>


        <div class="form-group">
          <label for="capacity">
            Kapasitas
          </label>

          <input
            id="capacity"
            type="number"
            name="capacity"
            min="0"
            value="0"
            placeholder="Jumlah kapasitas penghuni"
          >
        </div>


        <div class="form-group">
          <label for="picName">
            Nama PIC
          </label>

          <input
            id="picName"
            type="text"
            name="picName"
            maxlength="100"
            placeholder="Nama penanggung jawab"
          >
        </div>


        <div class="form-group">
          <label for="picPhone">
            Nomor Telepon PIC
          </label>

          <input
            id="picPhone"
            type="text"
            name="picPhone"
            maxlength="30"
            placeholder="Nomor telepon PIC"
          >
        </div>


        <div class="form-group">
          <label>Status</label>

          <select name="isActive">
            <option value="true" selected>
              Aktif
            </option>

            <option value="false">
              Tidak Aktif
            </option>
          </select>
        </div>


        <div class="form-group full">
          <label for="description">
            Keterangan
          </label>

          <textarea
            id="description"
            name="description"
            placeholder="Keterangan tambahan mengenai rumah mess..."
          ></textarea>
        </div>

      </div>


      <div class="actions">

        <a
          href="/dashboard"
          class="btn btn-cancel"
        >
          Dashboard
        </a>

        <a
          href="/houses"
          class="btn btn-cancel"
        >
          Batal
        </a>

        <button
          type="submit"
          class="btn btn-save"
        >
          Simpan Rumah Mess
        </button>

      </div>

    </form>

  </div>

</div>

</body>
</html>
