<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>MESS KSO | Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .dashboard {
      min-height: 100vh;
      display: flex;
    }

    /* SIDEBAR */

    .sidebar {
      width: 260px;
      background: #082d60;
      color: white;
      padding: 28px 18px;
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 12px 28px;
      border-bottom: 1px solid rgba(255,255,255,.12);
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: white;
      display: grid;
      place-items: center;
      color: #082d60;
      font-weight: 800;
    }

    .brand h1 {
      font-size: 19px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      font-size: 11px;
      opacity: .65;
    }

    .menu {
      margin-top: 28px;
    }

    .menu-title {
      padding: 0 12px;
      margin: 22px 0 9px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.2px;
      opacity: .45;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      margin-bottom: 5px;
      border-radius: 10px;
      color: rgba(255,255,255,.78);
      text-decoration: none;
      font-size: 14px;
    }

    .menu a:hover,
    .menu a.active {
      background: rgba(255,255,255,.12);
      color: white;
    }

    .sidebar-bottom {
      margin-top: auto;
    }

    .logout {
      width: 100%;
      border: 0;
      cursor: pointer;
      text-align: left;
      background: rgba(255,255,255,.08);
      color: white !important;
      border-radius: 10px;
    }

    .logout span {
      color: white !important;
    }

    .logout:hover {
      background: rgba(255,255,255,.15);
      color: white !important;
    }

    .logout:hover span {
      color: white !important;
    }

    /* MAIN */

    .main {
      margin-left: 260px;
      width: calc(100% - 260px);
      min-height: 100vh;
    }

    .topbar {
      height: 76px;
      background: white;
      border-bottom: 1px solid #e8edf4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 34px;
    }

    .page-title h2 {
      font-size: 20px;
    }

    .page-title p {
      margin-top: 4px;
      color: #8791a5;
      font-size: 13px;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .profile-name {
      font-size: 13px;
      font-weight: 700;
      text-align: right;
    }

    .profile-role {
      font-size: 11px;
      color: #16845b;
      margin-top: 3px;
      text-align: right;
      text-transform: uppercase;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e8f0fb;
      color: #082d60;
      display: grid;
      place-items: center;
      font-weight: 700;
    }

    .content {
      padding: 34px;
    }

    /* WELCOME */

    .welcome {
      background: linear-gradient(135deg, #082d60, #0b4b96);
      color: white;
      border-radius: 18px;
      padding: 30px;
      margin-bottom: 26px;
      position: relative;
      overflow: hidden;
    }

    .welcome::after {
      content: '';
      position: absolute;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      border: 35px solid rgba(255,255,255,.06);
      right: -70px;
      top: -80px;
    }

    .welcome small {
      opacity: .7;
      font-size: 12px;
    }

    .welcome h1 {
      margin-top: 8px;
      font-size: 27px;
    }

    .welcome p {
      margin-top: 8px;
      color: rgba(255,255,255,.72);
      font-size: 13px;
    }

    /* STAT CARDS */

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .card {
      background: white;
      border: 1px solid #e8edf4;
      border-radius: 16px;
      padding: 22px;
    }

    .card-label {
      color: #8b95a8;
      font-size: 12px;
      text-transform: uppercase;
    }

    .card-value {
      margin-top: 9px;
      font-size: 27px;
      font-weight: 800;
    }

    .card-desc {
      margin-top: 6px;
      color: #16845b;
      font-size: 11px;
    }

    /* SECTION */

    .section-grid {
      display: grid;
      grid-template-columns: 1.45fr 1fr;
      gap: 20px;
      margin-top: 22px;
    }

    .panel {
      background: white;
      border: 1px solid #e8edf4;
      border-radius: 16px;
      padding: 22px;
      min-width: 0;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .panel-header h3 {
      font-size: 15px;
    }

    .panel-header span {
      font-size: 11px;
      color: #8791a5;
    }

    .panel-header a {
      color: #1257a6;
      font-size: 12px;
      font-weight: 700;
    }

    /* OCCUPANT */

    .occupant-list {
      display: flex;
      flex-direction: column;
    }

    .occupant-item {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 13px 0;
      border-bottom: 1px solid #edf1f6;
    }

    .occupant-item:last-child {
      border-bottom: 0;
    }

    .occupant-photo {
      width: 44px;
      height: 44px;
      flex: 0 0 44px;
      border-radius: 12px;
      background: #e8f0fb;
      color: #1257a6;
      display: grid;
      place-items: center;
      font-size: 14px;
      font-weight: 800;
      overflow: hidden;
    }

    .occupant-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .occupant-info {
      min-width: 0;
      flex: 1;
    }

    .occupant-name {
      font-size: 13px;
      font-weight: 700;
      color: #172033;
    }

    .occupant-meta {
      margin-top: 4px;
      color: #8791a5;
      font-size: 11px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .status {
      padding: 5px 9px;
      border-radius: 20px;
      background: #e8f7ef;
      color: #16845b;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
    }

    /* HOUSE */

    .house-list {
      display: flex;
      flex-direction: column;
    }

    .house-item {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 13px 0;
      border-bottom: 1px solid #edf1f6;
    }

    .house-item:last-child {
      border-bottom: 0;
    }

    .house-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #eef4fc;
      color: #1257a6;
      display: grid;
      place-items: center;
      font-size: 19px;
    }

    .house-info {
      flex: 1;
      min-width: 0;
    }

    .house-name {
      font-size: 13px;
      font-weight: 700;
    }

    .house-meta {
      margin-top: 4px;
      color: #8791a5;
      font-size: 11px;
    }

    /* EMPTY */

    .empty {
      padding: 35px 15px;
      text-align: center;
      color: #9aa4b6;
      font-size: 12px;
    }

    /* QUICK */

    .quick-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 22px;
    }

    .quick-card {
      background: white;
      border: 1px solid #e8edf4;
      border-radius: 14px;
      padding: 18px;
      transition: .2s;
    }

    .quick-card:hover {
      border-color: #b9cce5;
      transform: translateY(-1px);
    }

    .quick-icon {
      font-size: 20px;
      color: #1257a6;
    }

    .quick-card strong {
      display: block;
      margin-top: 10px;
      font-size: 13px;
    }

    .quick-card small {
      display: block;
      margin-top: 4px;
      color: #8791a5;
      font-size: 10px;
    }

    /* RESPONSIVE */

    @media (max-width: 1100px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .section-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .sidebar {
        width: 220px;
      }

      .main {
        margin-left: 220px;
        width: calc(100% - 220px);
      }

      .content {
        padding: 20px;
      }

      .topbar {
        padding: 0 20px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .profile-name,
      .profile-role {
        display: none;
      }
    }
  </style>
</head>

<body>

<div class="dashboard">

  <!-- SIDEBAR -->

  <aside class="sidebar">

    <div class="brand">
      <div class="brand-icon">KSO</div>

      <div>
        <h1>MESS KSO</h1>
        <span>Management System</span>
      </div>
    </div>

    <nav class="menu">

      <div class="menu-title">MAIN MENU</div>

      <a href="/dashboard" class="active">
        <span>▦</span>
        <span>Dashboard</span>
      </a>

      <div class="menu-title">MASTER DATA</div>

      <a href="/occupants">
        <span>♟</span>
        <span>Penghuni</span>
      </a>

      <a href="/houses">
        <span>◆</span>
        <span>Rumah Mess</span>
      </a>

      <div class="menu-title">OPERASIONAL</div>

      <a href="#">
        <span>◉</span>
        <span>Monitoring</span>
      </a>

      <a href="#">
        <span>◷</span>
        <span>Aktivitas</span>
      </a>

      <div class="menu-title">SYSTEM</div>

      <a href="#">
        <span>⚙</span>
        <span>Pengaturan</span>
      </a>

    </nav>

    <div class="sidebar-bottom">

      <form method="POST" action="/logout">
        {{ csrfField() }}

        <button
          type="submit"
          class="menu logout"
        >
          <span style="color: white !important;">↪</span>
          <span style="color: white !important;">Logout</span>
        </button>
      </form>

    </div>

  </aside>


  <!-- MAIN -->

  <main class="main">

    <!-- TOPBAR -->

    <header class="topbar">

      <div class="page-title">
        <h2>Dashboard</h2>
        <p>Overview MESS KSO</p>
      </div>

      <div class="profile">

        <div>
          <div class="profile-name">
            {{ user.fullName || user.email }}
          </div>

          <div class="profile-role">
            {{ user.role }}
          </div>
        </div>

        <div class="avatar">
          {{ (user.fullName || user.email).charAt(0).toUpperCase() }}
        </div>

      </div>

    </header>


    <!-- CONTENT -->

    <section class="content">

      <!-- WELCOME -->

      <div class="welcome">

        <small>SELAMAT DATANG</small>

        <h1>
          {{ user.fullName || 'Administrator MESS KSO' }}
        </h1>

        <p>
          Sistem pencatatan dan pengelolaan data Rumah Mess KSO.
        </p>

      </div>


      <!-- STATISTICS -->

      <div class="cards">

        <div class="card">
          <div class="card-label">Total Penghuni</div>

          <div class="card-value">
            {{ totalOccupants }}
          </div>

          <div class="card-desc">
            Data penghuni
          </div>
        </div>


        <div class="card">
          <div class="card-label">Total Rumah Mess</div>

          <div class="card-value">
            {{ totalHouses }}
          </div>

          <div class="card-desc">
            Seluruh rumah
          </div>
        </div>


        <div class="card">
          <div class="card-label">Rumah Aktif</div>

          <div class="card-value">
            {{ activeHouses }}
          </div>

          <div class="card-desc">
            Rumah tersedia
          </div>
        </div>


        <div class="card">
          <div class="card-label">Kamar Terisi</div>

          <div class="card-value">
            {{ occupiedRooms }}
          </div>

          <div class="card-desc">
            Berdasarkan penghuni
          </div>
        </div>

      </div>


      <!-- DATA -->

      <div class="section-grid">


        <!-- PENGHUNI -->

        <div class="panel">

          <div class="panel-header">

            <h3>Penghuni Terbaru</h3>

            <a href="/occupants">
              Lihat semua →
            </a>

          </div>


          @if(recentOccupants.length)

            <div class="occupant-list">

              @each(occupant in recentOccupants)

                <a
                  href="/occupants/{{ occupant.id }}"
                  class="occupant-item"
                >

                  <div class="occupant-photo">

                    @if(occupant.photo)
                      <img
                        src="{{ occupant.photo }}"
                        alt="{{ occupant.name }}"
                      >
                    @else
                      {{ occupant.name.charAt(0).toUpperCase() }}
                    @end

                  </div>


                  <div class="occupant-info">

                    <div class="occupant-name">
                      {{ occupant.name }}
                    </div>

                    <div class="occupant-meta">

                      @if(occupant.position)
                        {{ occupant.position.name }}
                      @else
                        Jabatan belum diatur
                      @end

                      ·

                      @if(occupant.house)
                        {{ occupant.house.name }}
                      @else
                        Rumah belum diatur
                      @end

                      @if(occupant.roomNumber)
                        · Kamar {{ occupant.roomNumber }}
                      @end

                    </div>

                  </div>


                  <span class="status">
                    {{ occupant.status }}
                  </span>

                </a>

              @end

            </div>

          @else

            <div class="empty">
              Belum ada data penghuni.
            </div>

          @end

        </div>


        <!-- RUMAH -->

        <div class="panel">

          <div class="panel-header">

            <h3>Rumah Mess</h3>

            <a href="/houses">
              Lihat semua →
            </a>

          </div>


          @if(houses.length)

            <div class="house-list">

              @each(house in houses)

                <a
                  href="/houses/{{ house.id }}"
                  class="house-item"
                >

                  <div class="house-icon">
                    ⌂
                  </div>

                  <div class="house-info">

                    <div class="house-name">
                      {{ house.name }}
                    </div>

                    <div class="house-meta">

                      {{ house.code }}

                      @if(house.address)
                        · {{ house.address }}
                      @end

                    </div>

                  </div>

                  <span class="status">
                    Aktif
                  </span>

                </a>

              @end

            </div>

          @else

            <div class="empty">
              Belum ada data rumah mess.
            </div>

          @end

        </div>

      </div>


      <!-- QUICK ACCESS -->

      <div class="quick-grid">

        <a href="/occupants/create" class="quick-card">

          <div class="quick-icon">♟</div>

          <strong>
            Tambah Penghuni
          </strong>

          <small>
            Input data penghuni baru
          </small>

        </a>


        <a href="/houses/create" class="quick-card">

          <div class="quick-icon">⌂</div>

          <strong>
            Tambah Rumah Mess
          </strong>

          <small>
            Input rumah mess baru
          </small>

        </a>


        <a href="/occupants" class="quick-card">

          <div class="quick-icon">☷</div>

          <strong>
            Data Penghuni
          </strong>

          <small>
            Kelola seluruh penghuni
          </small>

        </a>


        <a href="/houses" class="quick-card">

          <div class="quick-icon">▣</div>

          <strong>
            Data Rumah
          </strong>

          <small>
            Kelola rumah mess
          </small>

        </a>

      </div>

    </section>

  </main>

</div>

</body>
</html>
