<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>MESS KSO | Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f4f7fb;
      color: #172033;
    }

    .dashboard {
      min-height: 100vh;
      display: flex;
    }

    /* SIDEBAR */

    .sidebar {
      width: 260px;
      background: #082d60;
      color: white;
      padding: 28px 18px;
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0 auto 0 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 12px 28px;
      border-bottom: 1px solid rgba(255,255,255,.12);
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: white;
      display: grid;
      place-items: center;
      color: #082d60;
      font-weight: 800;
    }

    .brand h1 {
      font-size: 19px;
    }

    .brand span {
      display: block;
      margin-top: 3px;
      font-size: 11px;
      opacity: .65;
    }

    .menu {
      margin-top: 28px;
    }

    .menu-title {
      padding: 0 12px;
      margin: 22px 0 9px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.2px;
      opacity: .45;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      margin-bottom: 5px;
      border-radius: 10px;
      color: rgba(255,255,255,.78);
      text-decoration: none;
      font-size: 14px;
    }

    .menu a:hover,
    .menu a.active {
      background: rgba(255,255,255,.12);
      color: white;
    }

    .sidebar-bottom {
      margin-top: auto;
    }

    /* MAIN */

    .main {
      margin-left: 260px;
      width: calc(100% - 260px);
      min-height: 100vh;
    }

    .topbar {
      height: 76px;
      background: white;
      border-bottom: 1px solid #e8edf4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 34px;
    }

    .page-title h2 {
      font-size: 20px;
    }

    .page-title p {
      margin-top: 4px;
      color: #8791a5;
      font-size: 13px;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e8f0fb;
      color: #082d60;
      display: grid;
      place-items: center;
      font-weight: 700;
    }

    .profile-name {
      font-size: 13px;
      font-weight: 700;
    }

    .profile-role {
      font-size: 11px;
      color: #16845b;
      margin-top: 3px;
    }

    .content {
      padding: 34px;
    }

    .welcome {
      background: linear-gradient(135deg, #082d60, #0b4b96);
      color: white;
      border-radius: 18px;
      padding: 30px;
      margin-bottom: 26px;
      position: relative;
      overflow: hidden;
    }

    .welcome::after {
      content: '';
      position: absolute;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      border: 35px solid rgba(255,255,255,.06);
      right: -70px;
      top: -80px;
    }

    .welcome small {
      opacity: .7;
      font-size: 12px;
    }

    .welcome h1 {
      margin-top: 8px;
      font-size: 27px;
    }

    .welcome p {
      margin-top: 8px;
      color: rgba(255,255,255,.72);
      font-size: 13px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .card {
      background: white;
      border: 1px solid #e8edf4;
      border-radius: 16px;
      padding: 22px;
    }

    .card-label {
      color: #8b95a8;
      font-size: 12px;
    }

    .card-value {
      margin-top: 9px;
      font-size: 27px;
      font-weight: 800;
    }

    .card-desc {
      margin-top: 6px;
      color: #16845b;
      font-size: 11px;
    }

    .section-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 20px;
      margin-top: 22px;
    }

    .panel {
      background: white;
      border: 1px solid #e8edf4;
      border-radius: 16px;
      padding: 22px;
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .panel-header h3 {
      font-size: 15px;
    }

    .panel-header span {
      font-size: 11px;
      color: #8791a5;
    }

    .activity {
      display: flex;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid #eef1f5;
    }

    .activity:last-child {
      border-bottom: 0;
    }

    .activity-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #eef5ff;
      display: grid;
      place-items: center;
      color: #0b4b96;
    }

    .activity strong {
      font-size: 13px;
    }

    .activity p {
      margin-top: 4px;
      color: #8b95a8;
      font-size: 11px;
    }

    .quick {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .quick a {
      text-decoration: none;
      color: #172033;
      border: 1px solid #e8edf4;
      border-radius: 12px;
      padding: 17px;
    }

    .quick a:hover {
      border-color: #b9cbe3;
      background: #f8fbff;
    }

    .quick-icon {
      font-size: 20px;
      margin-bottom: 9px;
    }

    .quick strong {
      display: block;
      font-size: 12px;
    }

    .quick span {
      display: block;
      margin-top: 4px;
      color: #8b95a8;
      font-size: 10px;
    }

    .logout {
      width: 100%;
      border: 0;
      background: rgba(255,255,255,.08);
      color: rgba(255,255,255,.75);
      border-radius: 10px;
      padding: 12px;
      cursor: pointer;
      font-size: 13px;
      text-align: left;
    }

    .logout:hover {
      background: rgba(255,255,255,.14);
      color: white;
    }

    /* MOBILE */

    @media (max-width: 1000px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .section-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .sidebar {
        width: 70px;
        padding: 18px 10px;
      }

      .brand {
        justify-content: center;
        padding: 0 0 20px;
      }

      .brand-text,
      .menu-title,
      .menu a span,
      .logout span {
        display: none;
      }

      .menu a,
      .logout {
        justify-content: center;
      }

      .main {
        margin-left: 70px;
        width: calc(100% - 70px);
      }

      .topbar {
        padding: 0 18px;
      }

      .profile-name,
      .profile-role {
        display: none;
      }

      .content {
        padding: 18px;
      }

      .welcome {
        padding: 22px;
      }

      .welcome h1 {
        font-size: 22px;
      }

      .cards {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .card {
        padding: 17px;
      }

      .section-grid {
        gap: 14px;
      }
    }

    @media (max-width: 430px) {
      .cards {
        grid-template-columns: 1fr;
      }

      .quick {
        grid-template-columns: 1fr;
      }
    }

/* =========================================================
   RESPONSIVE MOBILE
   ========================================================= */

@media (max-width: 768px) {

  html,
  body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  body {
    min-width: 0;
  }

  /* =========================
     DASHBOARD
     ========================= */

  .dashboard {
    width: 100%;
    min-height: 100vh;
    display: block;
    overflow-x: hidden;
  }


  /* =========================
     SIDEBAR
     ========================= */

  .sidebar {
    width: 100%;
    height: 64px;

    position: fixed;
    top: 0;
    left: 0;
    right: 0;

    z-index: 1000;

    padding: 0 16px;

    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    box-sizing: border-box;
  }

  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-mark {
    width: 38px;
    height: 38px;

    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: block;
  }

  .brand-text strong,
  .brand-text span {
    font-size: 13px;
  }


  /* =========================
     SIDEBAR MENU
     ========================= */

  .menu,
  .menu-title,
  .sidebar-bottom {
    display: none;
  }


  /* =========================
     MAIN
     ========================= */

  .main {
    width: 100%;
    min-width: 0;

    margin-left: 0;
    padding-top: 64px;

    box-sizing: border-box;
  }


  /* =========================
     TOPBAR
     ========================= */

  .topbar {
    width: 100%;
    height: 68px;

    padding: 0 16px;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .page-title h2 {
    font-size: 20px;
    line-height: 1.2;
  }

  .page-title p {
    font-size: 12px;
    margin-top: 3px;
  }

  .profile-name,
  .profile-role {
    display: none;
  }

  .profile-avatar {
    width: 38px;
    height: 38px;

    font-size: 14px;
  }


  /* =========================
     CONTENT
     ========================= */

  .content {
    width: 100%;
    padding: 16px;

    box-sizing: border-box;
  }


  /* =========================
     WELCOME HERO
     ========================= */

  .welcome-card,
  .hero,
  .welcome {
    width: 100%;
    box-sizing: border-box;
  }

  .welcome-card {
    min-height: 150px;
    padding: 24px;

    border-radius: 20px;
  }

  .welcome-card h1,
  .welcome-card h2 {
    font-size: 24px;
    line-height: 1.15;

    max-width: 100%;
  }

  .welcome-card p {
    font-size: 14px;
    line-height: 1.5;

    max-width: 90%;
  }


  /* =========================
     CARDS
     ========================= */

  .cards {
    width: 100%;

    display: grid;
    grid-template-columns: 1fr;

    gap: 12px;

    box-sizing: border-box;
  }

  .card {
    width: 100%;
    min-width: 0;

    box-sizing: border-box;

    padding: 22px;

    border-radius: 18px;
  }

  .card-label {
    font-size: 12px;
  }

  .card-value {
    font-size: 30px;
    line-height: 1.1;
  }

  .card-description {
    font-size: 12px;
  }


  /* =========================
     SECTION GRID
     ========================= */

  .section-grid {
    width: 100%;

    display: grid;
    grid-template-columns: 1fr;

    gap: 16px;

    box-sizing: border-box;
  }

  .section-card {
    width: 100%;
    min-width: 0;

    box-sizing: border-box;

    border-radius: 18px;
  }


  /* =========================
     QUICK ACCESS
     ========================= */

  .quick-access {
    width: 100%;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 10px;
  }

  .quick-item {
    min-width: 0;
    box-sizing: border-box;
  }


  /* =========================
     ACTIVITY
     ========================= */

  .activity-item {
    min-width: 0;
  }

  .activity-title {
    font-size: 14px;
  }

  .activity-description {
    font-size: 12px;
    line-height: 1.4;
  }

}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 480px) {

  .sidebar {
    height: 58px;
    padding: 0 12px;
  }

  .main {
    padding-top: 58px;
  }

  .topbar {
    height: 62px;
    padding: 0 14px;
  }

  .page-title h2 {
    font-size: 18px;
  }

  .content {
    padding: 12px;
  }


  /* HERO */

  .welcome-card {
    min-height: 0;
    padding: 20px;

    border-radius: 18px;
  }

  .welcome-card h1,
  .welcome-card h2 {
    font-size: 22px;
  }

  .welcome-card p {
    font-size: 13px;
    max-width: 100%;
  }


  /* STAT CARDS */

  .cards {
    gap: 10px;
  }

  .card {
    padding: 18px;
    border-radius: 16px;
  }

  .card-value {
    font-size: 28px;
  }


  /* QUICK ACCESS */

  .quick-access {
    grid-template-columns: 1fr;
  }


  /* SECTION */

  .section-grid {
    gap: 12px;
  }

}

/* =========================================================
   MESS KSO - MOBILE OVERRIDE
   ========================================================= */

@media (max-width: 768px) {

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  .dashboard {
    width: 100%;
    min-height: 100vh;
    display: block;
  }

  /* SIDEBAR MENJADI TOP NAV */

  .sidebar {
    position: fixed !important;

    top: 0 !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;
    height: 60px !important;

    padding: 10px 14px !important;

    display: flex !important;
    flex-direction: row !important;

    z-index: 9999;
  }

  .sidebar .menu,
  .sidebar .menu-title,
  .sidebar .sidebar-bottom {
    display: none !important;
  }

  /* MAIN FULL WIDTH */

  .main {
    width: 100% !important;
    max-width: 100% !important;

    margin-left: 0 !important;

    padding-top: 60px !important;

    overflow-x: hidden;
  }

  /* TOPBAR */

  .topbar {
    width: 100% !important;

    padding: 12px 16px !important;

    box-sizing: border-box;
  }

  /* CONTENT */

  .content {
    width: 100% !important;
    max-width: 100% !important;

    padding: 14px !important;

    box-sizing: border-box;
  }

  /* SEMUA GRID MENJADI 1 KOLOM */

  .cards {
    width: 100% !important;

    grid-template-columns: 1fr !important;

    gap: 12px !important;
  }

  .section-grid {
    width: 100% !important;

    grid-template-columns: 1fr !important;

    gap: 12px !important;
  }

  /* CARD */

  .cards > *,
  .section-grid > * {
    width: 100% !important;
    min-width: 0 !important;
  }

}


/* SMALL PHONE */

@media (max-width: 480px) {

  .sidebar {
    height: 56px !important;
  }

  .main {
    padding-top: 56px !important;
  }

  .content {
    padding: 12px !important;
  }

  .cards {
    gap: 10px !important;
  }

  .cards > * {
    padding: 18px !important;
  }

}
  </style>
</head>

<body>

<div class="dashboard">

  <aside class="sidebar">

    <div class="brand">
      <div class="brand-icon">KSO</div>

      <div class="brand-text">
        <h1>MESS KSO</h1>
        <span>Management System</span>
      </div>
    </div>

    <nav class="menu">

      <div class="menu-title">MAIN MENU</div>

      <a href="/dashboard" class="active">
        <span>▦</span>
        <span>Dashboard</span>
      </a>

      <div class="menu-title">MASTER DATA</div>

      <a href="#">
        <span>♙</span>
        <span>Users</span>
      </a>

      <a href="#">
        <span>◆</span>
        <span>Roles & Permission</span>
      </a>

      <div class="menu-title">OPERASIONAL</div>

      <a href="#">
        <span>◉</span>
        <span>Monitoring</span>
      </a>

      <a href="#">
        <span>◷</span>
        <span>Aktivitas</span>
      </a>

      <div class="menu-title">SYSTEM</div>

      <a href="#">
        <span>⚙</span>
        <span>Pengaturan</span>
      </a>

    </nav>
	<div class="sidebar-bottom">

  <form
    method="POST"
    action="/logout"
  >

    {{ csrfField() }}

    <button
      class="logout"
      type="submit"
    >
      <span>↪</span>
      <span>Logout</span>
    </button>

  </form>

</div>
    







  </aside>

  <main class="main">

    <header class="topbar">

      <div class="page-title">
        <h2>Dashboard</h2>
        <p>Overview MESS KSO</p>
      </div>

      <div class="profile">

        <div>
          <div class="profile-name">
            {{ user.fullName || user.email }}
          </div>

          <div class="profile-role">
            {{ user.role === 'super_admin' ? 'SUPER ADMIN' : 'RO MESS' }}
          </div>
        </div>

        <div class="avatar">
          {{ (user.fullName || user.email).charAt(0).toUpperCase() }}
        </div>

      </div>

    </header>

    <section class="content">

      <div class="welcome">

        <small>SELAMAT DATANG</small>

        <h1>
          {{ user.fullName || user.email }}
        </h1>

        <p>
          Anda login sebagai
          <strong>
            {{ user.role === 'super_admin' ? 'Super Administrator' : 'RO Mess' }}
          </strong>
          pada sistem MESS KSO.
        </p>

      </div>

      <div class="cards">

        <div class="card">
          <div class="card-label">TOTAL USER</div>
          <div class="card-value">1</div>
          <div class="card-desc">User aktif</div>
        </div>

        <div class="card">
          <div class="card-label">ROLE</div>
          <div class="card-value">
            {{ user.role === 'super_admin' ? 'ADMIN' : 'RO' }}
          </div>
          <div class="card-desc">Hak akses akun</div>
        </div>

        <div class="card">
          <div class="card-label">STATUS</div>
          <div class="card-value">ACTIVE</div>
          <div class="card-desc">Session aktif</div>
        </div>

        <div class="card">
          <div class="card-label">SYSTEM</div>
          <div class="card-value">KSO</div>
          <div class="card-desc">MESS Management</div>
        </div>

      </div>

      <div class="section-grid">

        <div class="panel">

          <div class="panel-header">
            <h3>Aktivitas Terbaru</h3>
            <span>Hari ini</span>
          </div>

          <div class="activity">
            <div class="activity-icon">✓</div>

            <div>
              <strong>Login berhasil</strong>
              <p>
                {{ user.fullName || user.email }}
                berhasil masuk ke sistem.
              </p>
            </div>
          </div>

          <div class="activity">
            <div class="activity-icon">●</div>

            <div>
              <strong>Session aktif</strong>
              <p>Sistem MESS KSO sedang berjalan normal.</p>
            </div>
          </div>

        </div>

        <div class="panel">

          <div class="panel-header">
            <h3>Quick Access</h3>
            <span>Akses cepat</span>
          </div>

          <div class="quick">

            <a href="#">
              <div class="quick-icon">♙</div>
              <strong>Users</strong>
              <span>Kelola pengguna</span>
            </a>

            <a href="#">
              <div class="quick-icon">◆</div>
              <strong>RBAC</strong>
              <span>Role & permission</span>
            </a>

            <a href="#">
              <div class="quick-icon">◉</div>
              <strong>Monitoring</strong>
              <span>Status operasional</span>
            </a>

            <a href="#">
              <div class="quick-icon">⚙</div>
              <strong>Settings</strong>
              <span>Pengaturan sistem</span>
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>

</div>

</body>
</html>

<style>

/* =========================================================
   MESS KSO - RESPONSIVE MOBILE/TABLET
   Desktop tetap normal di atas 1100px
   ========================================================= */

@media screen and (max-width: 1100px) {

  html,
  body {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    overflow-x: hidden !important;
  }

  * {
    box-sizing: border-box;
  }


  /* =======================================================
     SIDEBAR -> MOBILE TOPBAR
     ======================================================= */

  .sidebar {
    position: fixed !important;

    top: 0 !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;
    height: 64px !important;

    margin: 0 !important;

    padding: 0 16px !important;

    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;

    z-index: 9999 !important;

    border: 0 !important;
  }


  /* Hilangkan menu desktop */

  .sidebar .menu,
  .sidebar .menu-title,
  .sidebar-bottom {
    display: none !important;
  }


  /* =======================================================
     BRAND
     ======================================================= */

  .sidebar .brand {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
  }

  .sidebar .brand-mark {
    width: 40px !important;
    height: 40px !important;

    flex-shrink: 0 !important;
  }

  .sidebar .brand-text {
    display: block !important;
  }


  /* =======================================================
     MAIN CONTENT
     ======================================================= */

  .main {
    width: 100% !important;
    max-width: 100% !important;

    margin-left: 0 !important;

    padding-top: 64px !important;

    min-width: 0 !important;

    overflow-x: hidden !important;
  }


  /* =======================================================
     TOPBAR
     ======================================================= */

  .topbar {
    width: 100% !important;

    height: 68px !important;

    padding: 0 18px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;

    box-sizing: border-box !important;
  }


  .page-title h2 {
    font-size: 21px !important;
    line-height: 1.2 !important;
  }

